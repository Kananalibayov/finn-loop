# Copy this file to ".env" and fill in your real values.
# All vars are read server-side only and never sent to the browser.

# OpenAI API key for site generation.
OPENAI_API_KEY=sk-your-real-key-here

# --- Admin auth (issue #6) ---
# A bcrypt hash of your chosen admin password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# (npm install bcryptjs first if needed). Anyone who has this hash can verify
# a login, so keep it secret — but unlike a plaintext password, leaking the
# hash does not immediately reveal the password.
ADMIN_PASSWORD_HASH=$2a$10$replace-with-your-bcrypt-hash

# A random string used to sign session cookies. Use >= 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-32-plus-char-secret

# App URL, used for redirects (e.g. after logout). Defaults to localhost in dev.
NEXT_PUBLIC_URL=http://localhost:3000

# --- Deploy (issue #15) ---
# Host port the container publishes. Defaults to 3000 in docker-compose.yml.
# Change if another service is already on 3000.
PORT=3000
